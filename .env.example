# ---------------------------------------------------------------------------
# TJ SOCIAL — environment template. Copy to .env and fill in real values.
# NEVER commit real secrets. The Telegram bot token must stay server-side only.
# ---------------------------------------------------------------------------

# --- Telegram Mini App (required for real Telegram authentication) ----------
# Create/keep your bot with @BotFather, then link the Mini App to this URL.
TELEGRAM_BOT_TOKEN=
# Optional: used for the bot deep link shown on the sign-in screen.
TELEGRAM_BOT_USERNAME=

# --- Supabase (required for durable production data + media storage) -------
# Project settings -> API. The service role key is server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Storage bucket used for uploads (created by the migration).
SUPABASE_STORAGE_BUCKET=media

# --- Sessions ---------------------------------------------------------------
# Long random string, e.g. `openssl rand -hex 32`. Changing it logs everyone out.
SESSION_SECRET=

# --- Application ------------------------------------------------------------
PORT=3000
# Public origin of the deployed app, e.g. https://tj-social.example.com
APP_ORIGIN=
# Comma separated Telegram numeric IDs that must get administrator rights.
ADMIN_TELEGRAM_IDS=
# Local/Telegram-less sign-in for development and browser testing.
# Defaults to enabled when TELEGRAM_BOT_TOKEN is empty. Never enable in production.
ALLOW_DEV_LOGIN=
# Local data + upload directories (used only when Supabase is not configured).
DATA_DIR=./data
UPLOAD_DIR=./uploads
